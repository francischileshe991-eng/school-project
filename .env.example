# API Keys (Keep these private in your .env file — never commit .env)
# Google AI (Gemini) — used for Generation and Multilingual Translation
GOOGLE_API_KEY=your_google_ai_api_key_here
LLM_PROVIDER=gemini              # gemini, ollama, openai
TRANSLATION_PROVIDER=gemini      # gemini, nllb
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Application Configuration
APP_NAME="Zedchatbot for African Community"
APP_ENV=development  # development, testing, production
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=v1

# Vector Store Path
VECTOR_STORE_PATH=./vector_store

# Multilingual & Regional Settings
DEFAULT_COUNTRY=zm        # Default to Zambia
DEFAULT_LANGUAGE=en       # Default to English
SUPPORTED_COUNTRIES=["zm", "zw"]
SUPPORTED_LANGUAGES=["en", "bem", "ny", "sn"]

# Integration Settings
WHATSAPP_SANDBOX=True
