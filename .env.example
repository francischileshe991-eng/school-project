# ============================================================
# Zedchatbot for African Community - Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in your own credentials:
#   Windows (PowerShell):  copy .env.example .env
#   Linux/macOS:           cp .env.example .env
#
# SECURITY: `.env` is git-ignored. NEVER commit real keys.
# ============================================================

# ------------------------------------------------------------
# API Keys (leave blank to run fully offline via Ollama)
# ------------------------------------------------------------
# Google AI (Gemini) - primary provider for generation + translation
GOOGLE_API_KEY=your_google_ai_api_key_here

# Groq - optional high-speed fallback provider
GROQ_API_KEY=your_groq_api_key_here

# OpenAI - optional fallback provider
OPENAI_API_KEY=your_openai_api_key_here

# Twilio - required only for the WhatsApp Sandbox channel
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+14155238886

# ------------------------------------------------------------
# LLM & Translation Selection
# ------------------------------------------------------------
# LLM_PROVIDER: gemini | ollama | openai | groq | auto
#   gemini  = cloud, sub-second latency, high throughput
#   ollama  = local edge fallback (air-gapped resilience)
LLM_PROVIDER=gemini

# TRANSLATION_PROVIDER: gemini | nllb
#   nllb = local Meta NLLB-200 (offline, requires [translation] extra)
TRANSLATION_PROVIDER=gemini

MODEL_NAME=qwen2.5:7b
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=BAAI/bge-m3

# ------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------
APP_NAME="Zedchatbot for African Community"
APP_ENV=development          # development | testing | production
DEBUG=True
API_HOST=127.0.0.1            # use 0.0.0.0 to expose on the LAN
API_PORT=8000
API_VERSION=v1
PRELOAD_PIPELINE_ON_STARTUP=True

# ------------------------------------------------------------
# Paths
# ------------------------------------------------------------
# Vector store is a generated artifact. Rebuild it with:
#   python scripts/build_index.py --reset
VECTOR_STORE_PATH=./vector_store

# ------------------------------------------------------------
# Multilingual & Regional Settings
# ------------------------------------------------------------
DEFAULT_COUNTRY=zm           # zm (Zambia) | zw (Zimbabwe)
DEFAULT_LANGUAGE=en          # en | bem (Bemba) | ny (Nyanja/Chewa) | sn (Shona)
SUPPORTED_COUNTRIES=["zm", "zw"]
SUPPORTED_LANGUAGES=["en", "bem", "ny", "sn"]

# ------------------------------------------------------------
# Integration Settings
# ------------------------------------------------------------
WHATSAPP_SANDBOX=True
